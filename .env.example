# Core model configuration
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b

# Runtime
APP_ENV=development
HOST=127.0.0.1
PORT=5000
SECRET_KEY=replace-with-at-least-32-random-bytes
DATABASE_PATH=data/faq_chatbot.db

# Admin access
ADMIN_USERNAME=admin
# Generate with: python scripts/create_admin_hash.py
ADMIN_PASSWORD_HASH=replace-with-generated-password-hash
# Development-only alternative; never use in production:
# ADMIN_PASSWORD=change-me

# Protects the Prometheus-compatible /metrics endpoint in production.
METRICS_TOKEN=replace-with-a-long-random-token

# Rate limiting. Use Redis in production and memory:// only for one process.
RATELIMIT_STORAGE_URI=memory://
GLOBAL_RATE_LIMIT=120 per minute
CHAT_RATE_LIMIT=10 per minute
FEEDBACK_RATE_LIMIT=30 per minute
ADMIN_RATE_LIMIT=20 per minute

# Set to the exact number of trusted reverse proxies in front of the app.
TRUST_PROXY_COUNT=0

# Reliability and retention
MODEL_FAILURE_THRESHOLD=3
MODEL_COOLDOWN_SECONDS=30
MAX_QUESTION_LENGTH=500
MAX_STORED_ANSWERS=10000

# Local development only
FLASK_DEBUG=0
